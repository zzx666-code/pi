{
	"name": "@earendil-works/pi-customer-service-agent",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsgo -p tsconfig.build.json && vite build",
		"db:migrate": "tsx --tsconfig tsconfig.node.json src/db/migrate.ts",
		"knowledge:ingest": "tsx --tsconfig tsconfig.node.json src/knowledge/ingest.ts",
		"knowledge:verify": "tsx --tsconfig tsconfig.node.json src/knowledge/verify.ts",
		"dev:agent": "tsx --tsconfig tsconfig.node.json src/agent/server.ts",
		"dev:commerce": "tsx --tsconfig tsconfig.node.json src/commerce/server.ts",
		"dev:web": "vite",
		"eval": "tsx --tsconfig tsconfig.node.json src/evals/run.ts",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.85.1",
		"@earendil-works/pi-ai": "^0.85.1",
		"fastify": "5.12.4",
		"mysql2": "3.24.4",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"tsx": "4.22.1",
		"typescript": "5.9.3",
		"vite": "8.3.0",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
