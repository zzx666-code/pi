AGENT_PORT=3100
COMMERCE_PORT=3101
COMMERCE_BASE_URL=http://127.0.0.1:3101
COMMERCE_INTERNAL_TOKEN=replace-with-a-random-internal-token
MYSQL_URL=mysql://pi:pi@127.0.0.1:3307/pi_customer_service

# The agent reads provider credentials from ~/.pi/agent/models.json first (the same
# file the pi coding agent uses), matching LLM_PROVIDER against a provider entry.
# These variables are the fallback and are only needed when that file is absent.
# PI_CODING_AGENT_DIR overrides the config directory location.
LLM_PROVIDER=zhipu
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.5-air

AUTH_SECRET=replace-with-at-least-32-random-characters
DEMO_USER_ID=user-1
WEB_ORIGIN=http://127.0.0.1:5173
